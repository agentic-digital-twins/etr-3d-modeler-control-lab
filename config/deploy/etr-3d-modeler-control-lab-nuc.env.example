# Installed NUC service configuration.
# Copy to ~/.config/etr-3d-modeler-control-lab/modeler.env, then install the service.
# The browser server is LAN-reachable; the API stays loopback-only behind its proxy.

MODEL_API_HOST=127.0.0.1
MODEL_API_PORT=4230
MODEL_VIEWER_HOST=0.0.0.0
MODEL_VIEWER_PORT=4231
MODEL_API_UPSTREAM=http://127.0.0.1:4230
